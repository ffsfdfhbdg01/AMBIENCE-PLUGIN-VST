<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Ambience @VERSION@</title>
    <organization>com.ambienceaudio</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <!-- Destination: all users (/Library/...) or only the current user (~/Library/...). -->
    <domains enable_localSystem="true" enable_currentUserHome="true" enable_anywhere="false"/>
    <!-- "Customize" lets the user choose components. -->
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <os-version min="11.0"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="standalone"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in"
            description="Ambience.vst3 → Library/Audio/Plug-Ins/VST3 (Nuendo, Cubase, Reaper, Resolve, Premiere, Studio One…)."
            selected="true" enabled="true">
        <pkg-ref id="com.ambienceaudio.ambience.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU)"
            description="Ambience.component → Library/Audio/Plug-Ins/Components (Logic Pro, Final Cut Pro, GarageBand…)."
            selected="true" enabled="true">
        <pkg-ref id="com.ambienceaudio.ambience.au"/>
    </choice>
    <choice id="standalone" title="Standalone application"
            description="Ambience.app → Applications."
            selected="false" enabled="true">
        <pkg-ref id="com.ambienceaudio.ambience.standalone"/>
    </choice>

    <pkg-ref id="com.ambienceaudio.ambience.vst3">Ambience-vst3.pkg</pkg-ref>
    <pkg-ref id="com.ambienceaudio.ambience.au">Ambience-au.pkg</pkg-ref>
    <pkg-ref id="com.ambienceaudio.ambience.standalone">Ambience-standalone.pkg</pkg-ref>
</installer-gui-script>
